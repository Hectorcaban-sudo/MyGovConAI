{
  "name": "Pure n8n Contracts Router (Postgres + Chroma)",
  "nodes": [
    {
      "parameters": {},
      "id": "chat-trigger",
      "name": "When chat message received",
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.1,
      "position": [160, 400]
    },
    {
      "parameters": {
        "model": "={{ $env.ROUTER_MODEL || '/genai/Llama-4-Scout-17B' }}",
        "options": {
          "baseURL": "={{ $env.LLM_BASE_URL }}",
          "temperature": 0
        },
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "Classify the user question into exactly one route. Return ONLY valid JSON: {\"route\":\"sql_only|sql_and_docs|docs_only|reference_docs|llm_only\"}.\n\nsql_only: structured lookups (project name/ID, dates, counts, lists, federal filters, latest mods, opportunities).\nsql_and_docs: needs both metadata filter AND document content (specific project + summarize, or date-range + SOW content).\ndocs_only: broad semantic / past-performance / capability / SOW similarity search.\nreference_docs: how-to, policy, procedure, Salesforce guidance.\nllm_only: general knowledge or greetings."
            },
            {
              "role": "user",
              "content": "={{ $json.chatInput || $json.question }}"
            }
          ]
        }
      },
      "id": "router-llm",
      "name": "Route Classifier",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [380, 400],
      "credentials": {
        "openAiApi": {
          "id": "inhouse-llm",
          "name": "In-House LLM"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.message?.content || $input.first().json.text || '{}';\nlet route = 'docs_only';\ntry {\n  const parsed = JSON.parse(text.match(/\\{.*\\}/s)?.[0] || text);\n  route = parsed.route || route;\n} catch (e) {}\nreturn [{ json: { route, question: $('When chat message received').first().json.chatInput } }];"
      },
      "id": "parse-route",
      "name": "Parse Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [600, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "string": [{ "value1": "={{ $json.route }}", "operation": "equal", "value2": "sql_only" }] } },
            { "conditions": { "string": [{ "value1": "={{ $json.route }}", "operation": "equal", "value2": "sql_and_docs" }] } },
            { "conditions": { "string": [{ "value1": "={{ $json.route }}", "operation": "equal", "value2": "docs_only" }] } },
            { "conditions": { "string": [{ "value1": "={{ $json.route }}", "operation": "equal", "value2": "reference_docs" }] } }
          ]
        },
        "fallbackOutput": "extra"
      },
      "id": "switch",
      "name": "Route Switch",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [820, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \"Project\", \"Project_ID__c\", \"Contract_Name\", \"name\", \"Title\", \"link\", \"LinkFilename\", \"Modified\", \"lastModifiedDateTime\"\nFROM contracts_dataset_meta_prepared\nWHERE \"Project\" ILIKE '%' || $1 || '%'\n   OR \"Contract_Name\" ILIKE '%' || $1 || '%'\n   OR \"Project_ID__c\" ILIKE '%' || $1 || '%'\nORDER BY \"Modified\" DESC NULLS LAST\nLIMIT 20;",
        "options": {
          "queryReplacement": "={{ $json.question }}"
        }
      },
      "id": "postgres-sql",
      "name": "Postgres Lookup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1040, 180],
      "credentials": {
        "postgres": { "id": "pg", "name": "Contracts DB" }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHROMA_URL }}/api/v1/collections/IS_contracts_full_main_e5_documents/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.CHROMA_AUTH_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query_texts\": [\"{{ $json.question }}\"],\n  \"n_results\": 10\n}"
      },
      "id": "chroma-docs",
      "name": "Chroma Docs Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CHROMA_URL }}/api/v1/collections/IS_reference_main_e5/query",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ $env.CHROMA_AUTH_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query_texts\": [\"{{ $json.question }}\"],\n  \"n_results\": 8\n}"
      },
      "id": "chroma-ref",
      "name": "Chroma Reference Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, 620]
    },
    {
      "parameters": {
        "model": "={{ $env.ANSWER_MODEL || $env.ROUTER_MODEL }}",
        "options": { "baseURL": "={{ $env.LLM_BASE_URL }}", "temperature": 0.2 },
        "messages": {
          "messageValues": [
            {
              "role": "system",
              "content": "Answer the user's question using ONLY the retrieved context below. Keep it to 4 sentences or fewer. Always include relevant file links when present. If no relevant context, say so clearly."
            },
            {
              "role": "user",
              "content": "Question: {{ $('When chat message received').first().json.chatInput }}\n\nContext:\n{{ JSON.stringify($input.all()) }}"
            }
          ]
        }
      },
      "id": "answer-llm",
      "name": "Generate Answer",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [1280, 400],
      "credentials": {
        "openAiApi": { "id": "inhouse-llm", "name": "In-House LLM" }
      }
    }
  ],
  "connections": {
    "When chat message received": {
      "main": [[{ "node": "Route Classifier", "type": "main", "index": 0 }]]
    },
    "Route Classifier": {
      "main": [[{ "node": "Parse Route", "type": "main", "index": 0 }]]
    },
    "Parse Route": {
      "main": [[{ "node": "Route Switch", "type": "main", "index": 0 }]]
    },
    "Route Switch": {
      "main": [
        [{ "node": "Postgres Lookup", "type": "main", "index": 0 }],
        [{ "node": "Postgres Lookup", "type": "main", "index": 0 }],
        [{ "node": "Chroma Docs Search", "type": "main", "index": 0 }],
        [{ "node": "Chroma Reference Search", "type": "main", "index": 0 }],
        [{ "node": "Generate Answer", "type": "main", "index": 0 }]
      ]
    },
    "Postgres Lookup": {
      "main": [[{ "node": "Generate Answer", "type": "main", "index": 0 }]]
    },
    "Chroma Docs Search": {
      "main": [[{ "node": "Generate Answer", "type": "main", "index": 0 }]]
    },
    "Chroma Reference Search": {
      "main": [[{ "node": "Generate Answer", "type": "main", "index": 0 }]]
    }
  },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "pure-n8n" }, { "name": "contracts-router" }]
}
